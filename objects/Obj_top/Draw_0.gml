if(room!=Room1){
	draw_self()
	draw_set_color( #167B1F)
	draw_set_font(Font_base)
	draw_set_halign(fa_center)
	draw_set_valign(fa_middle)
	draw_text_ext_color(x,y-12,tex,50,300,#167B1F,#167B1F,#0D4C11,#0D4C11,1)
	draw_text_color(x-370,y,"Back",#e5d4b1,#e5d4b1,#a58964,#a58964,1)
	draw_text_color(x+370,y,"Next",#e5d4b1,#e5d4b1,#a58964,#a58964,1)
}










